{
  "manifest_version": 3,
  "name": "axuse bridge",
  "version": "1.1.0",
  "description": "Bridge your real Chrome to the axuse agent MCP server. Lets an agent harness control this browser through trusted CDP (chrome.debugger) while you watch.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["nativeMessaging", "tabs", "debugger"]
}
